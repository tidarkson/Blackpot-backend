generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// TENANT & CORE MODELS
// ===============================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations                   Location[]
  customers                   Customer[]
  menus                       Menu[]
  menuSections                MenuSection[]
  menuItems                   MenuItem[]
  orderItems                  OrderItem[]
  reservations                Reservation[]
  businessDays                BusinessDay[]
  users                       User[]
  activityLogs                ActivityLog[]
  notifications               Notification[]
  emailLogs                   EmailLog[]
  financialSetting            FinancialSetting?
  orders                      Order[]
  payments                    Payment[]
  tips                        Tip[]
  serviceCharges              ServiceCharge[]
  receipts                    Receipt[]
  kitchenStations             KitchenStation[]
  shifts                      Shift[]
  shiftClockIns               ShiftClockIn[]
  shiftTemplates              ShiftTemplate[]
  coverageRequirements        CoverageRequirement[]
  staffAvailabilityExceptions StaffAvailabilityException[]
  laborCostReports            LaborCostReport[]
  shiftConflicts              ShiftConflict[]
  shiftReports                ShiftReport[]                @relation("ShiftReports")
  reconciliationLogs          ReconciliationLog[]          @relation("ReconciliationLogs")
  reconciliations             Reconciliation[]
  cashSessions                CashSession[]
  cashCounts                  CashCount[]
  cardSettlements             CardSettlement[]
  discrepancies               Discrepancy[]
  specialRequests             SpecialRequest[]
  tableSections               TableSection[]
  splitPayments               SplitPayment[]
  splitPaymentItems           SplitPaymentItem[]
  splitPaymentRecords         SplitPaymentRecord[]
  waitlists                   Waitlist[]
  leaveRequests               LeaveRequest[]
  rolePermissions             RolePermission[]
  roleAuditLogs               RoleAuditLog[]
}

model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables          Table[]
  users           User[]
  kitchenStations KitchenStation[]
}

// ===============================
// CUSTOMER MANAGEMENT
// ===============================

model Customer {
  id       String @id @default(uuid())
  tenantId String

  // Basic info
  name  String
  phone String
  email String?

  // VIP Tracking
  vipStatus Boolean  @default(false)
  vipTier   VipTier? // 'GOLD' | 'PLATINUM' | 'DIAMOND'

  // Metrics
  lifetimeSpend Decimal   @default(0) @db.Decimal(12, 2)
  visitCount    Int       @default(0)
  lastVisit     DateTime?
  averageCheck  Decimal   @default(0) @db.Decimal(10, 2)

  // Preferences (JSON)
  preferences Json?

  // Metadata
  tags  String[] @default([])
  notes String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orders       Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([vipStatus])
  @@index([lifetimeSpend])
  @@index([visitCount])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
}

enum VipTier {
  GOLD
  PLATINUM
  DIAMOND
}

// ===============================
// USER & ACCESS CONTROL
// ===============================

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  locationId          String?
  email               String    @unique
  name                String
  passwordHash        String
  role                UserRole
  customRoleName      String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?

  // Staff-specific fields
  phone        String?
  hourlyRate   Decimal?      @db.Decimal(10, 2)
  hireDate     DateTime?
  availability Json? // Day-based availability: { "monday": { "available": true, "startTime": "09:00", "endTime": "17:00" }, ... }
  positions    StaffPosition[] // Job positions for STAFF users (can have multiple: ["SERVER", "CASHIER"])

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location                    Location?                    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serverOrders                Order[]                      @relation("ServerOrders")
  assignedOrders              Order[]                      @relation("AssignedOrders")
  tips                        Tip[]
  endOfDayCloses              EndOfDayClose[]
  passwordResets              PasswordReset[]
  shifts                      Shift[]
  shiftClockIns               ShiftClockIn[]
  assignedTables              Table[]                      @relation("TableServers")
  staffAvailabilityExceptions StaffAvailabilityException[]
  leaveRequests               LeaveRequest[]
  cashSessionsOpened          CashSession[]               @relation("CashSessionStaff")
  cashSessionsReviewed        CashSession[]               @relation("CashSessionReviewer")

  @@index([tenantId])
  @@index([role])
  @@index([customRoleName])
  @@index([email])
  @@index([hireDate])
}

model RolePermission {
  id          String   @id @default(cuid())
  tenantId    String
  roleName    String
  permissions Json
  isSystem    Boolean  @default(false)
  deletedAt   DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleName])
  @@index([tenantId])
  @@index([deletedAt])
}

model RoleAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String
  actorName String
  action    String
  roleName  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roleName])
  @@index([createdAt])
}

// ===============================
// MENU & ITEMS
// ===============================

model Menu {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections MenuSection[]
}

model MenuSection {
  id        String   @id @default(uuid())
  tenantId  String
  menuId    String
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menu   Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items  MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  tenantId    String
  sectionId   String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  allergens   String? // JSON array: ["PEANUTS", "DAIRY", "GLUTEN"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section           MenuSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  inventoryMappings MenuItemToInventory[]

  @@index([tenantId])
  @@index([sectionId])
}

// ===============================
// TABLES & RESERVATIONS
// ===============================

model TableSection {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // "Main Dining", "Patio", "Private Room", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables Table[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Table {
  id         String      @id @default(uuid())
  tenantId   String
  locationId String
  sectionId  String?
  serverId   String?
  name       String
  capacity   Int
  status     TableStatus @default(AVAILABLE)
  shape      TableShape  @default(RECTANGLE)
  x          Float
  y          Float
  width      Float
  height     Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  section      TableSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  server       User?         @relation("TableServers", fields: [serverId], references: [id], onDelete: SetNull)
  orders       Order[]
  reservations Reservation[]

  @@index([tenantId])
  @@index([locationId])
  @@index([sectionId])
  @@index([serverId])
  @@index([status])
}

model Reservation {
  id          String            @id @default(uuid())
  tenantId    String
  customerId  String?
  tableId     String
  guestCount  Int
  guestName   String
  guestEmail  String?
  guestPhone  String?
  reservedAt  DateTime
  status      ReservationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  cancelledAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table    Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([tableId])
  @@index([status])
  @@index([reservedAt])
}

// ===============================
// ORDERS & ITEMS
// ===============================

model Order {
  id                   String      @id @default(uuid())
  tenantId             String
  customerId           String?
  tableId              String
  serverId             String
  userId               String?
  shiftId              String?
  orderNumber          String? // Format: YYYYMMDD-0001
  status               OrderStatus @default(OPEN)
  guestCount           Int
  subtotal             Decimal     @default(0) @db.Decimal(10, 2)
  tax                  Decimal     @default(0) @db.Decimal(10, 2)
  total                Decimal     @default(0) @db.Decimal(10, 2)
  openedAt             DateTime    @default(now())
  closedAt             DateTime?
  lockedDate           DateTime?
  reconciliationStatus String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table           Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  server          User             @relation("ServerOrders", fields: [serverId], references: [id], onDelete: Cascade)
  assignedUser    User?            @relation("AssignedOrders", fields: [userId], references: [id], onDelete: SetNull)
  courses         OrderCourse[]
  payments        Payment[]
  tips            Tip[]
  serviceCharge   ServiceCharge?
  specialRequests SpecialRequest[]
  splitPayments   SplitPayment[]

  @@unique([tenantId, id]) // Composite for tenant isolation
  @@index([tenantId])
  @@index([customerId])
  @@index([tableId])
  @@index([serverId])
  @@index([status])
  @@index([closedAt])
  @@index([createdAt])
  @@index([tenantId, status, closedAt]) // Common query pattern
}

model OrderCourse {
  id               String     @id @default(uuid())
  tenantId         String
  orderId          String
  courseType       CourseType
  kitchenStationId String?
  firedAt          DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  kitchenStation KitchenStation? @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId])
  @@index([kitchenStationId])
  @@index([createdAt])
}

model OrderItem {
  id               String    @id @default(uuid())
  tenantId         String
  orderCourseId    String
  menuItemId       String
  quantity         Int
  specialNotes     String?
  allergenWarnings String? // JSON array of allergens from MenuItem
  preparedAt       DateTime?
  servedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderCourse OrderCourse        @relation(fields: [orderCourseId], references: [id], onDelete: Cascade)
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  splitItems  SplitPaymentItem[]

  @@index([orderCourseId])
  @@index([menuItemId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([preparedAt])
}

// ===============================
// SPECIAL REQUESTS & NOTES
// ===============================

model SpecialRequest {
  id          String               @id @default(uuid())
  tenantId    String
  orderId     String
  title       String
  description String?
  priority    Priority             @default(MEDIUM)
  status      SpecialRequestStatus @default(OPEN)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
}

// ===============================
// PAYMENTS & FINANCIAL
// ===============================

model Payment {
  id           String        @id @default(uuid())
  tenantId     String
  orderId      String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  status       PaymentStatus @default(COMPLETED)
  reference    String?
  cardLastFour String?
  processedAt  DateTime?
  reconciledAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([orderId])
  @@index([tenantId])
  @@index([method])
  @@index([status])
  @@index([createdAt])
  @@index([reconciledAt])
  @@index([tenantId, orderId, createdAt]) // Common reconciliation query
}

model Tip {
  id        String    @id @default(uuid())
  tenantId  String
  orderId   String
  serverId  String
  amount    Decimal   @db.Decimal(10, 2)
  method    TipMethod
  shiftId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  server User   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  shift  Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([serverId])
  @@index([createdAt])
}

model ServiceCharge {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String   @unique
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Receipt {
  id        String        @id @default(uuid())
  tenantId  String
  paymentId String        @unique
  number    String        @unique
  status    ReceiptStatus @default(PENDING)
  printedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ===============================
// SPLIT CHECKS
// ===============================

model SplitPayment {
  id           String        @id @default(uuid())
  tenantId     String
  orderId      String
  billNumber   Int // 1, 2, 3, etc. for this order
  personNumber Int // Person 1, Person 2, etc.
  subtotal     Decimal       @db.Decimal(10, 2)
  tax          Decimal       @db.Decimal(10, 2)
  total        Decimal       @db.Decimal(10, 2)
  paid         Decimal       @default(0) @db.Decimal(10, 2)
  remaining    Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING) // PENDING, PARTIAL, COMPLETED, FAILED
  splitType    String // "equal", "item", "custom"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items    SplitPaymentItem[]
  payments SplitPaymentRecord[]

  @@unique([orderId, billNumber])
  @@index([orderId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, orderId, status])
}

model SplitPaymentItem {
  id             String  @id @default(uuid())
  tenantId       String
  splitPaymentId String
  orderItemId    String
  quantity       Int
  price          Decimal @db.Decimal(10, 2) // Price for this person (may be portion of full item)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  splitPayment SplitPayment @relation(fields: [splitPaymentId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([splitPaymentId])
  @@index([orderItemId])
  @@index([tenantId])
}

model SplitPaymentRecord {
  id             String        @id @default(uuid())
  tenantId       String
  splitPaymentId String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED) // Track individual payment records
  reference      String?
  cardLastFour   String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  splitPayment SplitPayment @relation(fields: [splitPaymentId], references: [id], onDelete: Cascade)

  @@index([splitPaymentId])
  @@index([tenantId])
  @@index([method])
  @@index([status])
}

// ===============================
// KITCHEN & OPERATIONS
// ===============================

model KitchenStation {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  courses  OrderCourse[]
}

// ===============================
// BUSINESS OPERATIONS
// ===============================

model BusinessDay {
  id        String            @id @default(uuid())
  tenantId  String
  date      DateTime          @db.Date
  status    BusinessDayStatus @default(OPEN)
  openedAt  DateTime          @default(now())
  closedAt  DateTime?
  updatedAt DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endOfDayCloses EndOfDayClose[]
}

model EndOfDayClose {
  id             String   @id @default(uuid())
  tenantId       String
  businessDayId  String
  closedByUserId String
  totalSales     Decimal  @db.Decimal(10, 2)
  cashExpected   Decimal  @db.Decimal(10, 2)
  cashActual     Decimal  @db.Decimal(10, 2)
  discrepancy    Decimal  @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessDay  BusinessDay @relation(fields: [businessDayId], references: [id], onDelete: Cascade)
  closedByUser User        @relation(fields: [closedByUserId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String?
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ===============================
// EMAIL TRACKING & LOGGING
// ===============================

model EmailLog {
  id              String           @id @default(uuid())
  tenantId        String
  to              String[]
  cc              String[]         @default([])
  bcc             String[]         @default([])
  subject         String
  templateName    String?
  htmlContent     String?
  emailType       EmailType
  status          EmailStatus      @default(PENDING)
  relatedEntityId String?           // Order ID, User ID, etc.
  relatedEntityType String?         // "Order", "User", etc.
  
  // Delivery tracking
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  bounceType      BounceType?
  bounceReason    String?
  failureReason   String?
  
  // Retry info
  attempts        Int              @default(0)
  maxAttempts     Int              @default(5)
  nextRetryAt     DateTime?
  
  // Metadata
  metadata        Json?            // Store template data, SendGrid response, etc.
  externalId      String?          // Email service ID (SendGrid, Mailgun, etc.)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([status])
  @@index([emailType])
  @@index([createdAt])
  @@index([relatedEntityId])
  @@index([to])
  @@index([tenantId, status, emailType])
}

model FinancialSetting {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  taxRate           Decimal  @db.Decimal(5, 4)
  serviceChargeRate Decimal? @db.Decimal(5, 4)
  currency          String
  roundingStrategy  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ===============================
// INVENTORY & WINE CELLAR
// ===============================

model Supplier {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  contact        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
}

model InventoryItem {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  category     String
  unit         String
  currentStock Decimal  @db.Decimal(10, 2)
  minStock     Decimal  @db.Decimal(10, 2)
  unitCost     Decimal  @db.Decimal(10, 2)
  supplierId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier         Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements        StockMovement[]
  wineDetail       WineDetail?
  menuItemMappings MenuItemToInventory[]

  @@index([tenantId])
  @@index([category])
  @@index([supplierId])
}

model StockMovement {
  id              String   @id @default(uuid())
  tenantId        String
  inventoryItemId String
  type            String
  quantity        Decimal  @db.Decimal(10, 2)
  reason          String
  performedBy     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model WineDetail {
  id              String   @id @default(uuid())
  inventoryItemId String   @unique
  vintage         String?
  region          String?
  varietal        String?
  binLocation     String?
  tastingNotes    String?
  pairingNotes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model MenuItemToInventory {
  id              String   @id @default(uuid())
  tenantId        String
  menuItemId      String
  inventoryItemId String
  quantityNeeded  Decimal  @db.Decimal(10, 2)
  unit            String // Unit of measurement (should match inventory item unit)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([tenantId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}

// ===============================
// SHIFTS, TIPS & STAFF OPS
// ===============================

model Shift {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  // Scheduling fields
  scheduledDate  DateTime // The date of the shift
  scheduledStart DateTime // Scheduled start time
  scheduledEnd   DateTime // Scheduled end time

  // Actual time tracking
  clockInTime  DateTime?
  clockOutTime DateTime?

  // Shift details
  roleAssigned    String // server, cook, manager, host, bartender, sommelier
  shiftType       String? // morning, afternoon, evening (for cash reconciliation)
  sectionAssigned String? // For servers - which section
  breakMinutes    Int?     @default(0)
  hoursWorked     Decimal? @db.Decimal(10, 2) // Calculated
  notes           String?

  // Status
  status String @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED

  // Financial
  laborCost Decimal? @db.Decimal(10, 2) // Calculated based on hourlyRate

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tips     Tip[]
  clockIns ShiftClockIn[]
  cashSession CashSession?

  @@unique([tenantId, userId, scheduledDate, scheduledStart])
  @@index([userId])
  @@index([tenantId])
  @@index([scheduledDate])
  @@index([status])
  @@index([roleAssigned])
}

// Clock-in/out tracking
model ShiftClockIn {
  id           String    @id @default(uuid())
  tenantId     String
  shiftId      String
  clockInTime  DateTime
  clockOutTime DateTime?
  breakMinutes Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([tenantId])
  @@index([shiftId])
  @@index([clockInTime])
}

// Shift templates for recurring schedules
model ShiftTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  name         String // e.g., "Monday Morning Server"
  roleRequired String // server, cook, manager, host, bartender, sommelier
  dayOfWeek    Int // 0-6 (Sunday-Saturday)
  startTime    DateTime // Time of day
  endTime      DateTime // Time of day
  breakMinutes Int      @default(0)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([roleRequired])
  @@index([dayOfWeek])
}

// Coverage requirements
model CoverageRequirement {
  id           String    @id @default(uuid())
  tenantId     String
  roleRequired String // server, cook, manager, host, bartender, sommelier
  minimumStaff Int // Minimum staff needed for this role
  dayOfWeek    Int? // 0-6 (Sunday-Saturday), NULL for all days
  startTime    DateTime? // Optional time window
  endTime      DateTime? // Optional time window
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleRequired, dayOfWeek])
  @@index([tenantId])
  @@index([roleRequired])
}

// Staff availability overrides
model StaffAvailabilityException {
  id              String    @id @default(uuid())
  tenantId        String
  userId          String
  dateOfException DateTime
  isAvailable     Boolean // true = available despite blocked time, false = unavailable despite open time
  startTime       DateTime?
  endTime         DateTime?
  reason          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([dateOfException])
}

// Staff leave requests
model LeaveRequest {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy   String? // userId of approver
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, startDate, endDate])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// Labor cost tracking and reporting
model LaborCostReport {
  id               String   @id @default(uuid())
  tenantId         String
  reportDate       DateTime
  totalLaborCost   Decimal  @db.Decimal(12, 2)
  totalRevenue     Decimal  @db.Decimal(12, 2)
  laborCostPercent Decimal  @db.Decimal(5, 2) // Percentage
  staffCount       Int // Number of staff working
  totalHours       Decimal  @db.Decimal(10, 2)
  details          Json? // Breakdown by role
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportDate])
  @@index([tenantId])
  @@index([reportDate])
}

// Shift conflicts/warnings
model ShiftConflict {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String
  shiftId         String
  conflictType    String // OVERLAP, OVERTIME, UNAVAILABLE, UNDERSTAFFED
  conflictDetails Json // Details about the conflict
  isResolved      Boolean  @default(false)
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isResolved])
  @@index([conflictType])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ShiftReport {
  id           String   @id @default(uuid())
  tenantId     String
  reportDate   DateTime
  totalRevenue Decimal  @default(0) @db.Decimal(10, 2)
  totalOrders  Int      @default(0)
  totalCovers  Int      @default(0)
  averageCheck Decimal  @default(0) @db.Decimal(10, 2)
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation("ShiftReports", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportDate])
  @@index([tenantId])
  @@index([reportDate])
  @@index([createdAt])
}

model ReconciliationLog {
  id                   String   @id @default(uuid())
  tenantId             String
  reconciliationDate   DateTime
  totalOrders          Int
  matchedOrders        Int
  discrepancyCount     Int      @default(0)
  totalDiscrepancy     Decimal  @default(0) @db.Decimal(10, 2)
  reconciliationStatus String
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation("ReconciliationLogs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reconciliationDate])
  @@index([tenantId])
  @@index([reconciliationDate])
  @@index([reconciliationStatus])
  @@index([createdAt])
}

// ===============================
// SHIFT-LEVEL CASH RECONCILIATION
// ===============================

model CashSession {
  id                String              @id @default(uuid())
  tenantId          String
  shiftId           String              @unique // One-to-one relation to Shift
  staffId           String              // Staff member who opened the session
  
  // Cash tracking
  openingCash       Decimal             @db.Decimal(12, 2) // Cash register balance at shift start
  closingCash       Decimal?            @db.Decimal(12, 2) // Physical cash count at shift end
  expectedCash      Decimal?            @db.Decimal(12, 2) // Expected from orders (calculated)
  discrepancy       Decimal?            @db.Decimal(12, 2) // closingCash - expectedCash
  
  // Card tracking
  actualCard        Decimal?            @db.Decimal(12, 2) // Actual card amount counted
  cardDiscrepancy   Decimal?            @db.Decimal(12, 2) // actualCard - expectedCard (if calculated)
  
  // Cash denomination breakdown (JSON)
  cashDenominations Json?               // {"50": 10, "100": 5, "500": 2, "1000": 1}
  
  // Status tracking
  status            String              @default("OPEN") // OPEN, CLOSED, FLAGGED, APPROVED
  
  // Timestamps
  openedAt          DateTime            @default(now())
  closedAt          DateTime?
  
  // Manager review
  reviewedBy        String?             // Manager who reviewed
  reviewedAt        DateTime?
  managerNotes      String?
  
  // Audit trail
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift             Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff             User                @relation("CashSessionStaff", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer          User?               @relation("CashSessionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([staffId])
  @@index([status])
  @@index([openedAt])
  @@index([closedAt])
}

// ===============================
// END-OF-DAY RECONCILIATION
// ===============================

model Reconciliation {
  id                   String                 @id @default(uuid())
  tenantId             String
  businessDayId        String
  reconciliationDate   DateTime
  status               ReconciliationStatus   @default(PENDING)
  
  // Link to individual cash sessions
  cashSessionIds       String[]               @default([]) // Array of related CashSession IDs
  
  expectedCash         Decimal                @db.Decimal(12, 2) // Expected cash from orders
  actualCash           Decimal?               @db.Decimal(12, 2) // Physical count
  cardExpected         Decimal                @db.Decimal(12, 2) // Expected from card settlements
  cardActual           Decimal?               @db.Decimal(12, 2)
  cashDiscrepancy      Decimal?               @db.Decimal(12, 2) // Shortage/overage
  cardDiscrepancy      Decimal?               @db.Decimal(12, 2)
  isLocked             Boolean                @default(false) // Prevents order modifications
  approvedBy           String?                // User ID who approved
  approvedAt           DateTime?
  closedAt             DateTime?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashCounts         CashCount[]
  cardSettlements    CardSettlement[]
  discrepancies      Discrepancy[]

  @@unique([tenantId, reconciliationDate])
  @@index([tenantId])
  @@index([reconciliationDate])
  @@index([status])
  @@index([createdAt])
}

model CashCount {
  id              String   @id @default(uuid())
  tenantId        String
  reconciliationId String
  denomination    Decimal  @db.Decimal(12, 2) // e.g., 100.00, 50.00, 20.00, 10.00, 5.00, 1.00
  quantity        Int
  totalAmount     Decimal  @db.Decimal(12, 2) // denomination * quantity
  recordedBy      String   // User ID who recorded
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation    Reconciliation  @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconciliationId])
  @@index([recordedAt])
}

model CardSettlement {
  id              String   @id @default(uuid())
  tenantId        String
  reconciliationId String
  transactionCount Int
  settlementAmount Decimal  @db.Decimal(12, 2)
  processorFees   Decimal  @db.Decimal(10, 2)
  netAmount       Decimal  @db.Decimal(12, 2) // settlementAmount - processorFees
  settlementDate  DateTime
  cardBrand       String?  // VISA, MASTERCARD, AMEX, etc.
  status          String   @default("VERIFIED") // VERIFIED, UNVERIFIED, DISPUTED
  verifiedBy      String?  // User ID
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation   Reconciliation  @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconciliationId])
  @@index([cardBrand])
  @@index([status])
}

model Discrepancy {
  id              String              @id @default(uuid())
  tenantId        String
  reconciliationId String
  type            DiscrepancyType     // CASH_SHORTAGE, CASH_OVERAGE, UNMATCHED_TRANSACTION, REVERSED_TRANSACTION
  amount          Decimal             @db.Decimal(12, 2)
  reason          String? // Explanation or guess
  severity        DiscrepancySeverity @default(LOW) // LOW, MEDIUM, HIGH
  status          DiscrepancyStatus   @default(OPEN) // OPEN, UNDER_REVIEW, RESOLVED
  resolvedBy      String? // User ID who resolved
  resolution      String? // How it was resolved
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation   Reconciliation  @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconciliationId])
  @@index([type])
  @@index([severity])
  @@index([status])
}

// ===============================
// WAITLIST (FUTURE)
// ===============================

model Waitlist {
  id          String         @id @default(uuid())
  tenantId    String
  guestName   String
  guestPhone  String
  guestEmail  String?
  partySize   Int // 1-20
  position    Int // Queue position
  status      WaitlistStatus @default(WAITING)
  notes       String?
  addedAt     DateTime       @default(now())
  notifiedAt  DateTime?
  seatedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, guestPhone, addedAt]) // Prevent duplicate adds
  @@index([tenantId])
  @@index([status])
  @@index([guestPhone])
  @@index([addedAt])
}

// ===============================
// ENUMS
// ===============================

// Role hierarchy: OWNER > MANAGER > SUPERVISOR > STAFF > CUSTOMER
// For restaurant operations, use UserRole + StaffPosition
enum UserRole {
  OWNER       // Business owner, full system access
  MANAGER     // Department/location manager, operational control
  SUPERVISOR  // Shift supervisor, staff coordination
  STAFF       // Generic staff member, position-based permissions
  CUSTOMER    // External customer, limited access
}

// Staff positions for detailed permission control
// A STAFF user can have one or more positions
enum StaffPosition {
  SERVER      // Waitstaff, takes orders, serves
  HOST        // Seating, reservations, host stand
  CHEF        // Kitchen, food preparation, plating
  BARTENDER   // Bar, beverages, cocktails
  SOMMELIER   // Wine service, beverage expert
  CASHIER     // POS, payments, checkout
  DISHWASHER  // Kitchen support, cleaning
}

enum TableShape {
  CIRCLE
  SQUARE
  RECTANGLE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CourseType {
