# Database Configuration for BlackPot Backend
# Copy this file to .env and fill in your actual database URL

# PostgreSQL Database Connection
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# SERVER
NODE_ENV=development
PORT=3000
HOST=localhost

# DATABASE
DATABASE_URL=postgresql://blackpot_user:un1vers1ty@localhost:5432/blackpot_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# LOGGING
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# REDIS CACHE & SESSION STORE
# Configuration for Redis as caching layer and session store
# Improves performance by 8x and reduces database CPU by 70%

# Development: Use local Redis
# Staging/Production: Use Redis Cloud
# For Redis Cluster, set cluster: true in redisClient.ts

# Redis Connection Settings
# Redis Host
REDIS_HOST=localhost

# Redis Port (default: 6379)
REDIS_PORT=6379

# Redis Database number (0-15, default: 0)
REDIS_DB=0

# Redis Password (optional, required for Redis Cloud)
# Leave empty for local development without password
REDIS_PASSWORD=

# Enable/Disable Redis (default: true)
# Set to 'false' to disable Redis and use in-memory fallback
REDIS_ENABLED=true

# Environment-Specific Redis Configurations:

# Development (Local Redis via Docker)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Staging/Production (Redis Cloud)
# Get connection details from Redis Cloud Console
# REDIS_HOST=redis-instance.c123456.ng.0001.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_cloud_password

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# STRIPE
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# SOCKET.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# SENTRY ERROR TRACKING & PERFORMANCE MONITORING
# Get your DSN from https://sentry.io/settings/
# Development: You can use a test DSN or leave empty to disable Sentry
# Staging/Production: Use your actual Sentry project DSN
SENTRY_DSN=https://your-key@your-organization.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Sentry Performance Monitoring Sample Rates
# Trace sample rate: portion of transactions to send to Sentry (0.0 to 1.0)
# 1.0 = send all transactions (development)
# 0.1 = send 10% of transactions (staging)
# 0.05 = send 5% of transactions (production)
SENTRY_TRACES_SAMPLE_RATE=1.0

# Sentry Profiling Sample Rate (for performance profiling)
# 0.1 = send 10% of profiling data
# Only available with @sentry/profiling-node
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Sentry Debug Mode (enable verbose logging from Sentry SDK)
# Set to 'true' only in development for debugging
SENTRY_DEBUG=false

# Application Version for Sentry Release Tracking
# Update this when deploying new versions
APP_VERSION=1.0.0
```
