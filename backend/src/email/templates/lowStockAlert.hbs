<h2 style="color: #e67e22;">⚠️ Low Stock Alert</h2>

<p>Hi {{managerName}},</p>

<p>Several inventory items at {{restaurantName}} have fallen below their minimum stock levels. Please review and reorder as needed.</p>

<h3 style="margin-top: 24px; margin-bottom: 12px; color: #2c3e50;">Low Stock Items</h3>

<table>
  <thead>
    <tr>
      <th>Item Name</th>
      <th style="text-align: right;">Current Stock</th>
      <th style="text-align: right;">Minimum Level</th>
      <th style="text-align: right;">Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td>{{this.name}}</td>
      <td style="text-align: right;">{{this.currentStock}} {{this.unit}}</td>
      <td style="text-align: right;">{{this.minimumLevel}} {{this.unit}}</td>
      <td style="text-align: right;">
        {{#if this.isCritical}}
        <span style="color: #e74c3c; font-weight: bold;">CRITICAL</span>
        {{else}}
        <span style="color: #e67e22; font-weight: bold;">LOW</span>
        {{/if}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{#if requestedQty}}
<h3 style="margin-top: 24px; margin-bottom: 12px; color: #2c3e50;">Recommended Quantities</h3>

<table>
  <thead>
    <tr>
      <th>Item Name</th>
      <th style="text-align: right;">Supplier</th>
      <th style="text-align: right;">Recommended Order</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td>{{this.name}}</td>
      <td style="text-align: right;">{{this.supplier}}</td>
      <td style="text-align: right;">{{this.recommendedOrder}} {{this.unit}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

<p style="margin-top: 20px;">
  <a href="{{{inventoryLink}}}" class="button">View Inventory</a>
  <a href="{{{suppliersLink}}}" class="button button-secondary">Supplier Contacts</a>
</p>

<div class="alert-box">
  <strong>Action Required</strong>
  <p style="margin: 8px 0 0 0;">Please place reorders as soon as possible to avoid running out of these items.</p>
</div>

{{#if criticalItems}}
<div style="border-left: 4px solid #e74c3c; padding: 16px; margin: 20px 0; background-color: #ffebee; border-radius: 4px;">
  <strong style="color: #c62828;">Critical Stock Items</strong>
  <p style="margin: 8px 0 0 0; color: #c62828;">
    {{#each criticalItems}}
    {{this.name}}{{#unless @last}}, {{/unless}}
    {{/each}}
    are completely out or critically low. These items should be reordered immediately.
  </p>
</div>
{{/if}}

<h3 style="margin-top: 24px; margin-bottom: 12px; color: #2c3e50;">Stock Management Tips</h3>

<ul style="margin-left: 20px; color: #555;">
  <li>Review your sales trends to forecast future needs</li>
  <li>Set reorder points based on usage patterns</li>
  <li>Maintain supplier contact information for quick ordering</li>
  <li>Track delivery times to plan reorders in advance</li>
  <li>Check for expiration dates when stock arrives</li>
</ul>

<p style="margin-top: 20px;">
  For questions or to adjust stock alert settings, contact your account administrator.
</p>

<p style="color: #7f8c8d; font-size: 12px; margin-top: 20px;">
  Alert generated: {{alertDate}} | Location: {{restaurantName}} | Items: {{itemCount}}
</p>