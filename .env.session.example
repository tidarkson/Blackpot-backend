# Session Management Environment Variables
# Copy this to your .env file and customize for your environment

# Redis Configuration (Required for session storage)
# ================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_ENABLED=true

# Session Configuration
# =====================

# Session secret - use same as JWT_SECRET or generate new one
# For production, use a strong random string (min 32 characters)
SESSION_SECRET=your-super-secret-session-key-min-32-chars-long-abc123xyz

# Session timeout in milliseconds
# Default: 86400000 (24 hours)
# Formula: hours * 60 * 60 * 1000
SESSION_TIMEOUT_MS=86400000

# Remember me timeout in milliseconds  
# Default: 2592000000 (30 days)
# Used when user selects "Remember me" on login
# Formula: days * 24 * 60 * 60 * 1000
REMEMBER_ME_TIMEOUT_MS=2592000000

# Cookie domain (set for production)
# Example: yourdomain.com
# Leave empty for development (localhost)
COOKIE_DOMAIN=

# Enable session fingerprinting (security feature)
# Prevents session hijacking by validating device/browser consistency
# Default: true
SESSION_ENABLE_FINGERPRINTING=true

# Validate IP address for session consistency
# Strict security: Rejects if IP changes between requests
# Default: false (allows IP changes for mobile networks)
SESSION_VALIDATE_IP=false

# Maximum concurrent sessions per user
# How many devices can be logged in simultaneously
# Default: 3
# When exceeded, oldest session is removed
SESSION_MAX_CONCURRENT=3

# Node Environment
# ================
NODE_ENV=development
# Use 'production' for strict cookies (HTTPS only)
# Use 'development' for easier testing

# Server Configuration
# ====================
PORT=3000
HOST=localhost

# CORS Configuration
# Required for frontend communication
CORS_ORIGIN=http://localhost:3000

# Database
# ========
DATABASE_URL=postgresql://user:password@localhost:5432/blackpot

# JWT Configuration (Still used for API tokens)
# ==============================================
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Example Production Setup
# ========================
# 
# NODE_ENV=production
# REDIS_HOST=redis.production.internal
# REDIS_PASSWORD=<strong-password>
# SESSION_SECRET=<64-char-random-string>
# COOKIE_DOMAIN=yourdomain.com
# SESSION_VALIDATE_IP=true
# SESSION_MAX_CONCURRENT=5
#
# To generate a strong SESSION_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Example Multi-Server Load-Balancing Setup
# ==========================================
#
# All servers use same SESSION_SECRET and REDIS_HOST
# This ensures sessions are shared across all instances
#
# Server 1: (10.0.0.1)
# REDIS_HOST=shared-redis.internal
# SESSION_SECRET=same-secret-across-all-servers
#
# Server 2: (10.0.0.2)  
# REDIS_HOST=shared-redis.internal
# SESSION_SECRET=same-secret-across-all-servers
#
# Server 3: (10.0.0.3)
# REDIS_HOST=shared-redis.internal
# SESSION_SECRET=same-secret-across-all-servers
