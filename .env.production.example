# BlackPot Backend - Production Environment Variables
# Generated: February 9, 2026
# 
# IMPORTANT: 
# 1. Copy this file to .env.production
# 2. Replace ALL values with actual production credentials
# 3. NEVER commit .env.production to Git
# 4. Store in AWS Secrets Manager or Parameter Store
# 5. Rotate secrets every 90 days

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# API Configuration
API_PREFIX=/api
API_VERSION=v1
APP_NAME=BlackPot Backend
APP_DESCRIPTION=Restaurant POS SaaS System

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Supabase PostgreSQL (Primary)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?schema=public&sslmode=require

# Alternative: AWS RDS PostgreSQL
# DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@blackpot-prod.xxxxx.af-south-1.rds.amazonaws.com:5432/blackpot?sslmode=require

# Database connection pooling settings (if using RDS with PgBouncer)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=generate_a_strong_32_character_random_string_here_12345678
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Session encryption (for Cookie-based sessions if used)
SESSION_SECRET=another_strong_random_string_minimum_32_characters_long

# Password reset token expiry (in minutes)
PASSWORD_RESET_TOKEN_EXPIRY=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# REDIS CACHE & SESSION STORE
# ============================================================================

# AWS ElastiCache Redis
REDIS_URL=redis://YOUR_REDIS_ENDPOINT.ng.0001.af-south-1.cache.amazonaws.com:6379
REDIS_HOST=YOUR_REDIS_ENDPOINT.ng.0001.af-south-1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_AUTH_TOKEN
REDIS_DB=0
REDIS_SSL=true

# Cache settings
REDIS_CACHE_TTL=3600
SESSION_STORE=redis

# ============================================================================
# FILE STORAGE
# ============================================================================

# Cloudinary (Primary - Image CDN)
CLOUDINARY_URL=cloudinary://YOUR_CLOUDINARY_KEY:YOUR_CLOUDINARY_SECRET@YOUR_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_PREFIX=restaurant-saas

# AWS S3 (Fallback storage)
AWS_S3_ENABLED=true
AWS_REGION=af-south-1
AWS_S3_BUCKET=blackpot-prod-assets
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_CDN_URL=https://d1234567890.cloudfront.net

# ============================================================================
# PAYMENT PROCESSING
# ============================================================================

# Paystack (Primary Payment Gateway)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Flutterwave (Backup/Redundancy - if implemented)
FLUTTERWAVE_SECRET_KEY=sk_live_your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=pk_live_your_flutterwave_public_key_here
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_here

# Payment configuration
PAYMENT_ENABLED=true
PAYMENT_PRIMARY_GATEWAY=paystack
PAYMENT_FALLBACK_GATEWAY=flutterwave

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

# Nodemailer (Email service)
MAIL_HOST=smtp.YOUR_EMAIL_PROVIDER.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=your_email@blackpot.restaurant
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM_NAME=BlackPot Restaurant
MAIL_FROM_EMAIL=noreply@blackpot.restaurant

# Email templates
EMAIL_TEMPLATE_PATH=./src/templates/emails
PASSWORD_RESET_LINK=https://app.blackpot.restaurant/reset-password

# ============================================================================
# SMS & COMMUNICATION (Optional)
# ============================================================================

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry (Error tracking & monitoring)
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application Insights (Azure - optional alternative)
APPINSIGHTS_INSTRUMENTATION_KEY=your_instrumentation_key

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=combined
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
LOG_DIR=./logs

# Structured logging
LOG_JSON=true
LOG_TIMESTAMPS=true

# ============================================================================
# CORS & SECURITY
# ============================================================================

# CORS Configuration
CORS_ORIGIN=https://app.blackpot.restaurant,https://www.blackpot.restaurant
CORS_CREDENTIALS=true

# Frontend URL (for redirects)
FRONTEND_URL=https://app.blackpot.restaurant

# Allowed hosts (for security)
ALLOWED_HOSTS=api.blackpot.restaurant,api.staging.blackpot.restaurant

# ============================================================================
# AWS SERVICES (For Lambda & other AWS integrations)
# ============================================================================

AWS_ACCOUNT_ID=123456789012
AWS_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/BlackPotLambdaRole

# ============================================================================
# BACKGROUND JOBS & QUEUES
# ============================================================================

# Bull Job Queue Configuration
BULLMQ_REDIS_URL=redis://YOUR_REDIS_ENDPOINT.ng.0001.af-south-1.cache.amazonaws.com:6379
BULLMQ_DEFAULT_CONCURRENCY=5
BULLMQ_JOB_TIMEOUT=30000

# Job queue names
QUEUE_EMAIL=email-queue
QUEUE_NOTIFICATIONS=notification-queue
QUEUE_REPORTS=report-queue
QUEUE_RECONCILIATION=reconciliation-queue

# ============================================================================
# API DOCUMENTATION
# ============================================================================

# Swagger/OpenAPI
SWAGGER_ENABLED=true
SWAGGER_TITLE=BlackPot API Documentation
SWAGGER_DESCRIPTION=Restaurant POS SaaS API
SWAGGER_VERSION=1.0.0
SWAGGER_URL=/api/docs

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Feature toggles for gradual rollouts
FEATURE_SPLIT_PAYMENTS=true
FEATURE_ADVANCED_SCHEDULING=true
FEATURE_LOYALTY_PROGRAM=false
FEATURE_WASTE_TRACKING=false
FEATURE_PREDICTIVE_INVENTORY=false

# ============================================================================
# ANALYTICS & TRACKING
# ============================================================================

# Google Analytics (optional)
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Custom analytics events
ANALYTICS_ENABLED=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Matrix/Slack integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#blackpot-alerts

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Debug mode (MUST BE FALSE IN PRODUCTION)
DEBUG=false
DEBUG_QUERIES=false

# Request logging
LOG_REQUESTS=true
LOG_RESPONSES=false

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Connection timeouts (in ms)
DB_CONNECT_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000
API_REQUEST_TIMEOUT=30000

# Memory settings
NODE_OPTIONS=--max-old-space-size=1024

# ============================================================================
# COMPLIANCE & DATA PROTECTION
# ============================================================================

# Data retention policies
DATA_RETENTION_DAYS=2555

# PII handling
ENCRYPT_PII=true
PII_ENCRYPTION_KEY=your_encryption_key_32_chars_minimum

# GDPR compliance
GDPR_COMPLIANT=true
COOKIE_CONSENT_REQUIRED=true

# ============================================================================
# MULTI-TENANCY
# ============================================================================

MULTI_TENANT_ENABLED=true
TENANT_ISOLATION_LEVEL=strict

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================

# Before deploying, ensure:
# ✅ DATABASE_URL points to production database
# ✅ JWT_SECRET is a random 32+ character string (NOT "your-secret")
# ✅ All API keys are for LIVE/PRODUCTION mode
# ✅ PAYSTACK keys are from live account (pk_live_, sk_live_)
# ✅ REDIS_URL points to production ElastiCache instance
# ✅ CORS_ORIGIN matches your production frontend domain
# ✅ No sensitive data is logged (DEBUG=false)
# ✅ SENTRY_DSN is configured for error tracking
# ✅ Email configuration is tested
# ✅ Backups are configured in database
# ✅ SSL/TLS certificates are valid
# ✅ Rate limiting is appropriate for your scale
# ✅ This file is NOT committed to version control
# ✅ Secrets are stored in AWS Secrets Manager

# ============================================================================
# NOTES
# ============================================================================

# 1. Generate JWT_SECRET with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Paystack live keys format:
#    - Secret: sk_live_xxxxx
#    - Public: pk_live_xxxxx
#    Get from: https://dashboard.paystack.com/#/settings/developer
#
# 3. Store this file securely:
#    - AWS Secrets Manager: Production -> .env.production
#    - AWS Parameter Store: /blackpot/prod/env
#    - GitHub Secrets (if using GitOps)
#
# 4. Rotate secrets strategy:
#    - Change JWT_SECRET every 90 days
#    - Regenerate Paystack keys annually
#    - Rotate database password every 180 days
#    - Update AWS access keys every 90 days
#
# 5. Testing in production:
#    - Use Paystack test mode first
#    - Test email notifications to staging
#    - Verify Redis connectivity before going live
#    - Load test with production data volume
