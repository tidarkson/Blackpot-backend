# =============================================================================
# BlackPot Backend — Environment Variables
# Copy this file to .env and fill in your values.
# See docs/ENVIRONMENT_VARIABLES.md for full reference.
# =============================================================================

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=localhost

# Public-facing URL (required in production for email links, OAuth callbacks, etc.)
APP_URL=https://api.blackpot.com

# =============================================================================
# DATABASE
# =============================================================================
# Format: postgresql://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgresql://blackpot_user:un1vers1ty@localhost:5432/blackpot_dev

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================
# REQUIRED — minimum 32 characters; use 64+ in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# =============================================================================
# SESSION
# =============================================================================
# REQUIRED in production — minimum 32 characters; keep separate from JWT_SECRET
# Falls back to JWT_SECRET when not set (not recommended for production)
SESSION_SECRET=your-session-secret-change-this-in-production-min-32-chars
SESSION_TIMEOUT_MS=86400000
REMEMBER_ME_TIMEOUT_MS=2592000000
# SESSION_VALIDATE_IP=false
# SESSION_MAX_CONCURRENT=3
# COOKIE_DOMAIN=

# =============================================================================
# REDIS — cache & session store
# =============================================================================
# Set to 'false' to disable Redis and use in-memory fallback (dev only)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=              # Required for Redis Cloud / production

# Staging/Production (Redis Cloud)
# REDIS_HOST=redis-instance.c123456.ng.0001.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_cloud_password

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# STRIPE — payments
# =============================================================================
# Required for payment processing. Warnings are logged at startup if missing
# in production. Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# SENTRY — error tracking & performance monitoring
# =============================================================================
# Warning is logged at startup if missing in production.
# Get your DSN from https://sentry.io/settings/ → Projects → Client Keys (DSN)
SENTRY_DSN=https://your-key@your-organization.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Trace sample rate: 0.0–1.0  (1.0 = 100% in dev; 0.05 recommended in prod)
SENTRY_TRACES_SAMPLE_RATE=1.0
# Profiling sample rate: 0.0–1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Set true only when debugging the Sentry SDK itself
SENTRY_DEBUG=false

# =============================================================================
# EMAIL
# =============================================================================
# EMAIL_PROVIDER options: TEST | GMAIL | SENDGRID | ETHEREAL
EMAIL_PROVIDER=TEST
EMAIL_FROM=noreply@blackpot.com

# Gmail
# GMAIL_USER=your@gmail.com
# GMAIL_PASSWORD=your-app-password

# Ethereal (auto-generated test accounts — https://ethereal.email)
# ETHEREAL_USER=
# ETHEREAL_PASSWORD=

# SendGrid
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# APP
# =============================================================================
APP_VERSION=1.0.0

# Socket.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
```
